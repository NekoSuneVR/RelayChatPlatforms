# Discord
DISCORD_BOT_TOKEN=

# GameVox
GAMEVOX_BOT_TOKEN=
GAMEVOX_WEBHOOK_URL=

# Stoat
STOAT_BOT_TOKEN=

# Vector: nsec or hex private key. Ignored if vector-bot-account.json exists.
# A twelve-word seed phrase in VECTOR_MNEMONIC works instead.
VECTOR_PRIVATE_KEY=
# Optional: comma-separated relay list (defaults to wss://jskitty.cat/nostr,wss://relay.damus.io)
VECTOR_RELAYS=
# Optional: path to the compiled MLS sidecar, required for "group:<id>" channels
VECTOR_MLS_SIDECAR_BIN=

# Root (no bot token; used by "npm run root:dev" to reach your test community)
DEV_TOKEN=

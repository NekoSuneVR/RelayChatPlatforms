{
  "platforms": {
    "discord-main": {
      "type": "discord",
      "displayName": "Discord",
      "tokenEnv": "DISCORD_BOT_TOKEN"
    },
    "gamevox-main": {
      "type": "gamevox",
      "displayName": "GameVox",
      "tokenEnv": "GAMEVOX_BOT_TOKEN"
    },
    "stoat-main": {
      "type": "stoat",
      "displayName": "Stoat",
      "tokenEnv": "STOAT_BOT_TOKEN"
    },
    "vector-main": {
      "type": "vector",
      "displayName": "Vector",
      "tokenEnv": "VECTOR_PRIVATE_KEY",
      "relaysEnv": "VECTOR_RELAYS",
      "mlsSidecarBinEnv": "VECTOR_MLS_SIDECAR_BIN",
      "profile": {
        "name": "relaybot",
        "displayName": "Relay Bot",
        "about": "Multi-platform chat relay"
      }
    },
    "rootapp-main": {
      "type": "rootapp",
      "displayName": "Root"
    }
  },
  "relayGroups": [
    {
      "id": "community-chat",
      "name": "Community Chat",
      "channels": [
        {
          "platform": "discord-main",
          "channelId": "DISCORD_CHANNEL_ID_HERE"
        },
        {
          "platform": "gamevox-main",
          "channelId": "GAMEVOX_CHANNEL_ID_HERE"
        },
        {
          "platform": "stoat-main",
          "channelId": "STOAT_CHANNEL_ID_HERE"
        },
        {
          "platform": "vector-main",
          "channelId": "group:VECTOR_GROUP_ID_HERE"
        },
        {
          "platform": "rootapp-main",
          "channelId": "ROOT_CHANNEL_ID_HERE"
        }
      ]
    }
  ],
  "options": {
    "relayAttachments": true,
    "relayWebhookMessages": true,
    "showPlatform": true,
    "showRelayGroup": false,
    "preventEveryoneMentions": true
  }
}
